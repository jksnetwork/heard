[Desktop Entry]
Type=Application
Name=Heard
GenericName=Dictation
Comment=Speak instead of typing: speech to text into any app
Exec=heard launch
Icon=io.github.jksnetwork.Heard
Terminal=false
Categories=Utility;Accessibility;GTK;
Keywords=dictation;speech;voice;transcribe;whisper;speech-to-text;
StartupNotify=false
DBusActivatable=false
Actions=toggle;send;history;settings;quit;

[Desktop Action toggle]
Name=Start/Stop Dictation
Exec=heard toggle
X-KDE-Shortcuts=Meta+Shift+H

[Desktop Action send]
Name=Stop Dictation and Press Enter
Exec=heard send
X-KDE-Shortcuts=Meta+Shift+Return

[Desktop Action history]
Name=History
Exec=heard history

[Desktop Action settings]
Name=Settings
Exec=heard settings

[Desktop Action quit]
Name=Quit Heard
Exec=heard quit
